{
  "name": "sql-editor",
  "version": "0.1.0",
  "description": "A desktop SQL database client built with Electron and React",
  "main": "./out/main/main.js",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron-vite dev -w",
    "format": "prettier --write --list-different .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx",
    "test:sqlite": "npm run vite:build:app && node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/sqlite-adapter.test.ts tests/sqlite-worker.test.ts",
    "start": "electron-vite preview",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "vite:build:app": "electron-vite build",
    "electron:build:win": "electron-builder --win",
    "electron:build:mac": "electron-builder --mac",
    "electron:build:linux": "electron-builder --linux",
    "electron:build:dir": "electron-builder --dir",
    "build:unpack": "npm run vite:build:app && npm run electron:build:dir",
    "build:win": "npm run vite:build:app && npm run electron:build:win",
    "build:mac": "npm run vite:build:app && npm run electron:build:mac",
    "build:linux": "npm run vite:build:app && npm run electron:build:linux",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/view": "^6.43.14",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@uiw/react-codemirror": "^4.25.12",
    "electron-conveyor": "^0.4.0",
    "lucide-react": "^1.32.0",
    "styled-components": "^6.1.19",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6"
  }
}
